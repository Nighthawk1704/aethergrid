{
  "name": "aethergrid",
  "version": "0.1.0",
  "description": "AetherGrid - real-time multiplayer ASCII MMORPG (terminal + browser clients)",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22" },
  "scripts": {
    "start": "tsx src/server/main.ts",
    "server": "tsx src/server/main.ts",
    "client": "tsx src/client-tui/main.ts",
    "build:web": "node scripts/build-web.mjs",
    "simulate-bots": "tsx src/server/bots.ts",
    "demo": "tsx src/server/demo.ts",
    "typecheck": "tsc --noEmit",
    "check": "tsc --noEmit && npm test && npm run test:tui && npm run test:game",
    "test": "tsx src/server/selftest.ts",
    "test:game": "tsx src/server/gametest.ts",
    "test:tui": "tsx src/client-tui/tui.test.ts"
  },
  "dependencies": {
    "better-sqlite3": "^12.0.0",
    "express": "^4.21.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/express": "^4.17.21",
    "@types/node": "^22.0.0",
    "@types/ws": "^8.5.12",
    "esbuild": "^0.25.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
